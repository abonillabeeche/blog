[0.003, "o", "\u001b[3m                Failover Summary                \u001b[0m\r\n╭──────────────────────────────┬───────────────╮\r\n│\u001b[1m \u001b[0m\u001b[1mMetric                      \u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1m        Value\u001b[0m\u001b[1m \u001b[0m│\r\n├──────────────────────────────┼───────────────┤\r\n│\u001b[1m \u001b[0m\u001b[1;34mVMs stopped on source\u001b[0m\u001b[1m       \u001b[0m\u001b[1m \u001b[0m│             1 │\r\n│\u001b[1m \u001b[0m\u001b[1;35mVolumes final-synced\u001b[0m\u001b[1m        \u001b[0m\u001b[1m \u001b[0m│             3 │\r\n│\u001b[1m \u001b[0m\u001b[1;32mVMs started on DR\u001b[0m\u001b[1m           \u001b[0m\u001b[1m \u001b[0m│             1 │\r\n│\u001b[1m \u001b[0m\u001b[1;2m  stop\u001b[0m\u001b[1m                      \u001b[0m\u001b[1m \u001b[0m│            6s │\r\n│\u001b[1m \u001b[0m\u001b[1;2m  final_sync\u001b[0m\u001b[1m                \u001b[0m\u001b[1m \u001b[0m│           21s │\r\n│\u001b[1m \u001b[0m\u001b[1;2m  promote\u001b[0m\u001b[1m                   \u001b[0m\u001b[1m \u001b[0m│           28s │\r\n│\u001b[1m \u001b[0m\u001b[1;2m  start\u001b["]
[0.000, "o", "0m\u001b[1m                     \u001b[0m\u001b[1m \u001b[0m│           15s │\r\n│\u001b[1m \u001b[0m\u001b[1;36mTotal RTO\u001b[0m\u001b[1m                   \u001b[0m\u001b[1m \u001b[0m│ 72s  (1m 12s) │\r\n│\u001b[1m \u001b[0m\u001b[1;36mRPO harvey-dr-demo/dr-demo-1\u001b[0m\u001b[1m \u001b[0m│ 0s (lossless) │\r\n╰──────────────────────────────┴───────────────╯\r\n"]
[0.003, "o", "\r\nNext: once primary is healthy, run \u001b[1;36mharvey reprotect -n \u001b[0m\u001b[1;36m<\u001b[0m\u001b[1;36mns\u001b[0m\u001b[1;36m> <vm\u001b[0m\u001b[1;36m>\u001b[0m to replicate back \u001b[1m(\u001b[0mdr → primary\u001b[1m)\u001b[0m.\r\n"]
[0.036, "o", "\r\n"]
[1.517, "o", "\u001b[1;36m# On DR: the last write before the stop is there; the only gap is the outage window\u001b[0m\r\n"]
