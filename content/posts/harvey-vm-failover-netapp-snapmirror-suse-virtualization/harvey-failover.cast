[0.001, "o", "\u001b[3m                        Failover Plan: \u001b[0m\u001b[3;36mprimary\u001b[0m\u001b[3m → \u001b[0m\u001b[3;32mdr\u001b[0m\u001b[3m                         \u001b[0m\r\n╭────────┬─────────┬────────────────┬───────────┬──────────┬───────────────╮\r\n│\u001b[1m \u001b[0m\u001b[1mStop #\u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1mStart #\u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1mNamespace     \u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1mVM Name  \u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1mPriority\u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1mStartup Delay\u001b[0m\u001b[1m \u001b[0m│\r\n├────────┼─────────┼────────────────┼───────────┼──────────┼───────────────┤\r\n│\u001b[33m \u001b[0m\u001b[33m     1\u001b[0m\u001b[33m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m      1\u001b[0m\u001b[32m \u001b[0m│\u001b[36m \u001b[0m\u001b[36mharvey-dr-demo\u001b[0m\u001b[36m \u001b[0m│\u001b[35m \u001b[0m\u001b[35mdr-demo-1\u001b[0m\u001b[35m \u001b[0m│      100 │             — │\r\n"]
